{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "author_or_org",
    "url_or_identifier",
    "publication_date",
    "retrieved_at",
    "publisher",
    "source_type",
    "independence_group"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 3
    },
    "title": { "type": "string", "minLength": 1 },
    "author_or_org": { "type": "string", "minLength": 1 },
    "url_or_identifier": { "type": "string", "minLength": 3 },
    "publication_date": { "type": "string", "format": "date" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "publisher": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "independence_group": {
      "type": "string",
      "enum": ["independent", "mixed", "conflicted", "unknown"]
    }
  }
}
