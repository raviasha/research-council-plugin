{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "entailment_check",
    "source_quality",
    "corroboration",
    "contradiction_status",
    "disposition",
    "confidence_rationale",
    "reviewer_notes"
  ],
  "properties": {
    "claim_id": { "type": "string", "minLength": 3 },
    "entailment_check": { "type": "string", "enum": ["unsupported", "partially-supported", "supported", "well-supported"] },
    "source_quality": { "type": "string", "enum": ["low", "medium", "high"] },
    "corroboration": { "type": "string", "enum": ["weak", "mixed", "strong"] },
    "contradiction_status": { "type": "string", "enum": ["none", "open", "resolved"] },
    "disposition": {
      "type": "string",
      "enum": ["Approved", "Approved-with-caveat", "Contested", "Insufficient-evidence", "Rejected"]
    },
    "confidence_rationale": { "type": "string", "minLength": 5 },
    "reviewer_notes": { "type": "string", "minLength": 3 }
  }
}
