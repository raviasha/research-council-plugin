{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "version",
    "user_problem",
    "intended_use",
    "objective",
    "research_questions",
    "definitions",
    "scope",
    "constraints",
    "output",
    "success_criteria",
    "assumptions"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "user_problem": { "type": "string" },
    "intended_use": { "type": "string" },
    "objective": { "type": "string" },
    "research_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "text"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string", "minLength": 2 },
          "text": { "type": "string", "minLength": 2 }
        }
      }
    },
    "definitions": {
      "type": "object"
    },
    "scope": { "type": "string" },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output": { "type": "string" },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
